{
  "name": "@linmu/dsh-session-adapter-lynn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "development": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./legacy": {
      "development": "./src/legacy.ts",
      "types": "./dist/legacy.d.ts",
      "default": "./dist/legacy.js"
    },
    "./session-graph-store": {
      "development": "./src/session-graph-store.ts",
      "types": "./dist/session-graph-store.d.ts",
      "default": "./dist/session-graph-store.js"
    },
    "./session-lifecycle": {
      "development": "./src/session-lifecycle.ts",
      "types": "./dist/session-lifecycle.d.ts",
      "default": "./dist/session-lifecycle.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@linmu/dsh-session-contracts": "workspace:*",
    "@linmu/dsh-session-adapter-host": "workspace:*",
    "zod": "4.1.5",
    "@linmu/dsh-session-store": "workspace:*"
  }
}
