{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Session Maintenance · 来源导入与原生提交",
    "locale": "zh-CN"
  },
  "lanes": [
    {
      "id": "platform",
      "label": "Harness 平台适配"
    },
    {
      "id": "engine",
      "label": "Engine / Lifecycle"
    },
    {
      "id": "host",
      "label": "DSH 插件 / Provider"
    },
    {
      "id": "dashboard",
      "label": "Dashboard 阅读"
    }
  ],
  "groups": [
    {
      "id": "source-import",
      "label": "来源观察与格式解释",
      "lane": "platform",
      "fromCol": 0,
      "toCol": 3
    },
    {
      "id": "engine-commit",
      "label": "身份、租约与持久化责任",
      "lane": "engine",
      "fromCol": 0,
      "toCol": 5
    },
    {
      "id": "host-lifetime",
      "label": "宿主持久化与排空",
      "lane": "host",
      "fromCol": 2,
      "toCol": 4
    }
  ],
  "nodes": [
    {
      "id": "import",
      "lane": "platform",
      "col": 0,
      "type": "backend",
      "label": "只读观察来源",
      "sublabel": "Codex / DSH 稳定观察",
      "width": 190
    },
    {
      "id": "canonical",
      "lane": "engine",
      "col": 0,
      "type": "backend",
      "label": "纳入规范会话",
      "sublabel": "身份 · 版本 · 来源权",
      "width": 190
    },
    {
      "id": "prepare",
      "lane": "engine",
      "col": 1,
      "type": "backend",
      "label": "准备与恢复空间",
      "sublabel": "冻结本 run 范围 / 租约",
      "width": 190
    },
    {
      "id": "materialize",
      "lane": "platform",
      "col": 1,
      "type": "backend",
      "label": "编码并核验原生",
      "sublabel": "按快照过滤 / 范围缓存",
      "width": 190
    },
    {
      "id": "run",
      "lane": "host",
      "col": 2,
      "type": "backend",
      "label": "attach 与实际运行",
      "sublabel": "官方 persistence · 新增事件",
      "width": 190
    },
    {
      "id": "wal",
      "lane": "engine",
      "col": 2,
      "type": "backend",
      "label": "核对并持久化意图",
      "sublabel": "WAL / operationId",
      "width": 190
    },
    {
      "id": "normalize",
      "lane": "platform",
      "col": 3,
      "type": "backend",
      "label": "规范化实际追加",
      "sublabel": "校验平台来源与身份",
      "width": 190
    },
    {
      "id": "receipt",
      "lane": "engine",
      "col": 3,
      "type": "backend",
      "label": "提交规范版本与回执",
      "sublabel": "事务内范围/删除复核",
      "width": 190
    },
    {
      "id": "read",
      "lane": "dashboard",
      "col": 4,
      "type": "frontend",
      "label": "按需阅读持久结果",
      "sublabel": "问答 / 过程 / 业务目录",
      "width": 190
    },
    {
      "id": "drain",
      "lane": "host",
      "col": 4,
      "type": "backend",
      "label": "停止时排空写入",
      "sublabel": "drain / detach",
      "width": 190
    },
    {
      "id": "close",
      "lane": "engine",
      "col": 5,
      "type": "backend",
      "label": "核对并关闭运行",
      "sublabel": "保留可复用原生空间",
      "width": 190
    },
    {
      "id": "recover",
      "lane": "engine",
      "col": 4,
      "type": "backend",
      "label": "中断恢复核对",
      "sublabel": "原 run 快照 / WAL / 回执",
      "width": 190,
      "yOffset": 125
    }
  ],
  "edges": [
    {
      "id": "e0",
      "from": "import",
      "to": "canonical",
      "label": "稳定观察"
    },
    {
      "id": "canonical-prepare",
      "from": "canonical",
      "to": "prepare",
      "label": "已导入内容"
    },
    {
      "id": "prepare-materialize",
      "from": "prepare",
      "to": "materialize",
      "label": "受控投影 DTO"
    },
    {
      "id": "e1",
      "from": "materialize",
      "to": "run",
      "label": "准备完毕后 attach"
    },
    {
      "id": "run-wal",
      "from": "run",
      "to": "wal",
      "label": "直接追加请求"
    },
    {
      "id": "wal-normalize",
      "from": "wal",
      "to": "normalize",
      "label": "WAL + 原生已应用"
    },
    {
      "id": "e2",
      "from": "normalize",
      "to": "receipt",
      "label": "规范事件 / 证据"
    },
    {
      "id": "e3",
      "from": "receipt",
      "to": "read",
      "label": "持久结果可查询"
    },
    {
      "id": "receipt-drain",
      "from": "receipt",
      "to": "drain",
      "label": "停止触发",
      "role": "branch"
    },
    {
      "id": "drain-close",
      "from": "drain",
      "to": "close",
      "label": "尾部收敛"
    },
    {
      "id": "recover-in",
      "from": "run",
      "to": "recover",
      "label": "中断 / 未确认尾部",
      "role": "error",
      "variant": "dashed"
    },
    {
      "id": "recover-out",
      "from": "recover",
      "to": "prepare",
      "label": "证据核对后重建准备",
      "role": "return",
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "import",
    "canonical",
    "prepare",
    "materialize",
    "run",
    "wal",
    "normalize",
    "receipt",
    "read"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "import"
    ],
    "allowedTerminals": [
      "read",
      "close"
    ],
    "requiredPaths": [
      {
        "from": "run",
        "to": "receipt"
      },
      {
        "from": "recover",
        "to": "prepare"
      }
    ]
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "调用依据",
      "items": [
        "导入与启动同步是两个步骤；图不表示启动会自动导入全部新正文。",
        "运行追加：WAL → 原生应用 → Adapter规范化 → Canonical提交 → 回执。",
        "图/上下文领域写入不与本流程串成一条虚构的主路径；分别查对应接口记录。"
      ]
    },
    {
      "dot": "cyan",
      "title": "范围规则",
      "items": [
        "用户保存分类工作区策略只影响下次启动，不改当前运行快照。",
        "提交再次核验当前成员关系与删除状态；拒绝时保留未完成操作。",
        "公共信息页是独立协作接口，不串入会话追加的主流程。"
      ]
    }
  ]
}
